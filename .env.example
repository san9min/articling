# Copy this file to .env and fill in real values. .env is already excluded
# via .gitignore — never commit real credentials.
#
#   cp .env.example .env

# --- relations extra (LLM CAPTION_OF/REFERENCES proposals, VLM captioning, PDF chunking) ---
# articling.relations.propose.propose_edges() and articling.chunking.vlm_chunker
# create `openai.OpenAI()` with no arguments when you don't pass your own
# `client=`, so the openai SDK reads these automatically — no code change
# needed, just having them in the environment is enough.
OPENAI_API_KEY=

# Optional: only needed for a non-default OpenAI-compatible endpoint
# (self-hosted / proxy / Azure OpenAI gateway). Leave unset to use the
# default https://api.openai.com/v1.
# OPENAI_BASE_URL=

# Optional: only needed if your account belongs to multiple orgs/projects.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# --- neo4j extra (push_to_neo4j) ---
# NOT auto-read by articling — push_to_neo4j(document, uri, auth) takes the
# URI and (user, password) as explicit arguments. These names are just the
# convention; load them yourself, e.g.:
#
#   from dotenv import load_dotenv; load_dotenv()
#   import os
#   push_to_neo4j(doc, os.environ["NEO4J_URI"],
#                 (os.environ["NEO4J_USER"], os.environ["NEO4J_PASSWORD"]))
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
